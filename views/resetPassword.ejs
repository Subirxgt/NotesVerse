<% layout("/layouts/boilerplate") -%>

<div class="container mt-5">
  <form
    class="auth-form"
    id="resetPasswordForm"
    method="POST"
    action="/user/password/reset/<%= token %>?_method=PUT"
  >
    <h2>Reset Password</h2>

    <p class="text-muted mb-4">
      Enter your new password below and confirm it to reset your account password.
    </p>

    <div class="mb-3">
        <div class="position-relative">
          <input
            type="password"
            name="password"
            placeholder="Enter new password"
            class="form-control pe-5"
            minlength="8"
            maxlength="32"
            required
          />
          <i
            class="bi bi-eye-slash position-absolute top-50 end-0 translate-middle-y me-3 toggle-password"
            style="cursor: pointer; color: #6c757d;"
          ></i>
        </div>
        <small class="form-text text-muted d-block mt-1">
          Password must be between 8 and 32 characters
        </small>
      </div>


    <div class="mb-3">
        <div class="position-relative">
          <input
            type="password"
            name="confirmPassword"
            placeholder="Enter new Confirm password"
            class="form-control pe-5"
            minlength="8"
            maxlength="32"
            required
          />
          <i
            class="bi bi-eye-slash position-absolute top-50 end-0 translate-middle-y me-3 toggle-password"
            style="cursor: pointer; color: #6c757d;"
          ></i>
        </div>
        <small class="form-text text-muted d-block mt-1">
          Password must be between 8 and 32 characters
        </small>
      </div>

    <button type="submit" class="btn btn-primary w-100">
      Reset Password
    </button>

    <div class="text-center mt-4">
      <a href="/user/auth" class="text-decoration-none">Back to Login</a>
    </div>
  </form>
</div>

<style>
  body {
    font-family: "Poppins", sans-serif;
    background: #f9f9f9;
  }

  .auth-form {
    max-width: 420px;
    background: #fff;
    padding: 2.5rem;
    margin: auto;
    border-radius: 16px;
    box-shadow: 0 0 15px rgba(0,0,0,0.08);
  }

  .auth-form h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    font-weight: 600;
    color: #333;
  }

  .auth-form .btn-primary {
    background-color: #007bff;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: 500;
    transition: background 0.3s ease;
  }

  .auth-form .btn-primary:hover {
    background-color: #0056b3;
  }

  .auth-form input {
    border-radius: 8px;
    padding: 12px;
    font-size: 15px;
  }

  .auth-form .alert {
    border-radius: 8px;
    font-size: 14px;
  }

  .auth-form a {
    color: #007bff;
  }

  .auth-form a:hover {
    text-decoration: underline;
  }
</style>
