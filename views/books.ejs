<% layout("/layouts/boilerplate")-%>
<body>
  <div class="notes-container">
    <% for (let book of books) { %>
      <div class="semester-card">
        
        <div class="semester-header" style="justify-content: space-between;">
          <h3><%= book.semester %></h3>
          <span class="subject-count"><%= book.subjects.length %> Subjects</span>
        </div>
        <hr>

        <div class="subjects">
          <% for (let subject of book.subjects) { %>
            <div class="subject-chip chip-with-icon" onclick="window.open('<%= subject.file %>', '_blank')" style="position: relative; cursor: pointer;">
                <div class="chip-title"><%= subject.title %></div>
                <div class="chip-contributor">
                  contributed by: <%= subject.contributor?.username || "Unknown" %>
                </div>
              </a>
              <% if (typeof user !== 'undefined' && user && user.email==="notesverse1199@gmail.com") { %>
                <form action="/books/delete" method="POST" class="delete-form" 
                  onsubmit="return confirm('Are you sure you want to delete this file?');">
                  <input type="hidden" name="id" value="<%= subject._id.toString() %>">
                  <button type="submit" class="delete-btn" onclick="event.stopPropagation();">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              <% } %>
            </div>
          <% } %>
        </div>

      </div>
    <% } %>
  </div>
</body>



<script>
  document.addEventListener("DOMContentLoaded", function() {
    if (user?.email === "suman1091792@gmail.com") {
      const deleteForms = document.getElementsByClassName('delete-form');
      for (let i = 0; i < deleteForms.length; i++) {
        deleteForms[i].style.display = "block";
      }
    }
  });
</script>