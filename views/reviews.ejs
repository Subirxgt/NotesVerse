<% layout("/layouts/boilerplate")-%>
<div class="col-8 offset-2 mb-3 mt-2">
    <h3 class="fw-bold text-center mb-4">User Reviews</h3>

    <% if (typeof user !== 'undefined' && user) { %>
        <div class="card shadow-sm border-0 p-4 mb-4">
            <h5 class="mb-3 text-primary fw-semibold">
                <i class="bi bi-pencil-square me-2"></i>Leave a Review
            </h5>

            <form action="/reviews" method="post" novalidate class="needs-validation">
                <div class="mt-3 mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mt-3 mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="subject-chip chip-title btn-outline-dark w-100 p-3 shadow-sm" style="align-items: center; border: white;">Submit</button>
            </form>
        </div>
    <% } else { %>
        <div class="alert alert-warning text-center shadow-sm mt-4">
            <i class="bi bi-person-circle me-2"></i>
            Please <a href="/user/auth" class="fw-semibold text-decoration-none">login</a> to leave a review.
        </div>
    <% } %>

    <hr>
    <p><b>All Reviews</b></p>
    <div class="row">
        <%for(review of reviews){%>
        <div class="card col-lg-5 col-8 mb-3 ms-3" style="padding-top: 5px;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h5 class="card-title">@<%= review.username %></h5>
                    <% if (typeof user !== 'undefined' && user && (user.name===review.username || user.email==="notesverse1199@gmail.com")) { %>
                    <form action="/reviews/<%= review._id %>?_method=DELETE" method="POST"
                        onsubmit="return confirm('Delete this review?')">
                        <button class="review-delete-btn">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                    <%}%>
                </div>
                <h6 class="card-subtitle mb-2 text-body-secondary">
                    <%= new Date(review.createdAt).toLocaleString('en-GB', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                        hour: 'numeric',
                        minute: '2-digit',
                        hour12: true
                    }).replace(',', ' •') %>
                </h6>
                <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
                <p class="card-text mb-2" style="font-size: large;"><%= review.comment %></p>
            </div>
        </div>

        <%}%>
    </div>
</div>
<hr class="my-5">

<div class="card shadow-sm border-0 text-center p-4 mb-5">
    <h5 class="fw-bold text-primary mb-3">
        <i class="bi bi-chat-dots me-2"></i>Contact Us
    </h5>
    <p class="fw-semibold text-secondary mb-2">
        Have feedback, found an issue, or want to suggest something?
    </p>
    <p class="mb-0">
        <i class="bi bi-envelope-at text-danger me-2"></i>
        <a href="mailto:notesverse1199@gmail.com" class="fw-semibold text-decoration-none text-dark">
            notesverse1199@gmail.com
        </a>
    </p>
</div>



