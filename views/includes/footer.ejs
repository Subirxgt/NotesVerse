<script>
  fetch("/api/visits/last-7-days")
    .then(res => res.json())
    .then(data => {
      const el = document.getElementById("weeklySessions");
      if (el && data.totalVisits !== undefined) {
        el.innerText = data.totalVisits;
      }
    })
    .catch(() => {
      const el = document.getElementById("weeklySessions");
      if (el) el.innerText = "N/A";
    });
</script>
